{
  "version": 1,
  "principle": "Store connection metadata only. Never store token values, private keys, passwords, cookies, or OAuth client secrets in this file.",
  "defaultAuthority": "repository",
  "authorityClasses": [
    {
      "id": "repository",
      "description": "Non-privileged internal documentation and durable agent protocols."
    },
    {
      "id": "document-authority",
      "description": "Role-scoped documents in Drive, SharePoint, Box, Notion, Confluence, or equivalent."
    },
    {
      "id": "communication-authority",
      "description": "Email, calendar, chat, and message threads."
    },
    {
      "id": "data-authority",
      "description": "Structured privileged data in SQLite, Postgres, app databases, or managed stores."
    }
  ],
  "connections": [
    {
      "id": "example-google-workspace",
      "provider": "google-workspace",
      "authorityClass": "document-authority",
      "status": "not-configured",
      "owner": "repo-maintainers",
      "accountRef": "group-or-user@example.com",
      "allowedOperations": ["read"],
      "credentialRefs": ["keychain:google-workspace-oauth"],
      "scopeRefs": ["drive.readonly"],
      "authoritativeFor": ["role-restricted documents"],
      "revocation": "Remove OAuth grant and Drive permissions for this account or group.",
      "notes": "Replace or remove this example before relying on it."
    }
  ],
  "connectorProfiles": [
    {
      "id": "example-google-workspace",
      "provider": "google-workspace",
      "status": "inactive",
      "mode": "remote",
      "description": "Example repo-owned connector profile. Replace with real project-safe metadata before activating.",
      "serverNames": {
        "workspace": "example-google-workspace",
        "drive": "example-drive",
        "mail": "example-mail"
      },
      "remoteConnectorUrls": {
        "drive": "https://drivemcp.googleapis.com/mcp/v1"
      },
      "authStorageClass": "provider-secure-storage-or-external-secret-store",
      "credentialRootRef": "env:HARNESS_CONNECTOR_HOME",
      "expectedAccountDomain": "example.com",
      "readOnlyScopes": ["drive.readonly"],
      "approvalGatedWriteScopes": ["drive.file"],
      "cliAuth": {
        "status": "inactive",
        "profileBoundary": "repository",
        "globalStatePolicy": "refuse-global-mutable-state",
        "configRoot": {
          "strategy": "env",
          "env": "HARNESS_CONNECTOR_HOME",
          "providerSubdir": "google-workspace"
        },
        "authFlowTypes": ["browser", "device-code", "copied-code"],
        "browserPolicy": "explicit-browser-is-binding",
        "identityCheckCommands": [
          "./{{CLI_NAME}} connections doctor --profile example-google-workspace --mode remote"
        ]
      },
      "writeApproval": {
        "required": true,
        "policy": "Explicit human approval is required before write-capable connector scopes are enabled."
      },
      "verificationCommands": [
        "./{{CLI_NAME}} connections plan",
        "./{{CLI_NAME}} connections doctor --profile example-google-workspace --mode remote"
      ],
      "revocation": "Remove provider grant and delete external token storage for this profile.",
      "genericFallbackRule": "Use generic connectors only when this repo-owned profile is missing, inaccessible, unsupported by the client, or explicitly blocked by a linked work item."
    },
    {
      "id": "example-gcloud",
      "provider": "gcloud",
      "status": "inactive",
      "mode": "local",
      "description": "Example Google Cloud CLI profile using a repository-scoped CLOUDSDK_CONFIG root.",
      "authStorageClass": "repository-scoped-config-root",
      "expectedAccountLabelRef": "repo-google-cloud-account",
      "readOnlyScopes": ["cloud-platform.read-only"],
      "cliAuth": {
        "status": "inactive",
        "profileBoundary": "repository",
        "globalStatePolicy": "refuse-global-mutable-state",
        "configRoot": {
          "strategy": "env",
          "env": "CLOUDSDK_CONFIG",
          "providerSubdir": "gcloud"
        },
        "authFlowTypes": ["browser", "copied-code"],
        "browserPolicy": "explicit-browser-is-binding",
        "identityCheckCommands": [
          "gcloud auth list --filter=status:ACTIVE",
          "gcloud config get-value project"
        ]
      },
      "verificationCommands": [
        "./{{CLI_NAME}} connections auth-plan --profile example-gcloud",
        "./{{CLI_NAME}} connections env --profile example-gcloud"
      ],
      "revocation": "Revoke the Google Cloud OAuth grant and remove this profile's external config root."
    },
    {
      "id": "example-neon",
      "provider": "neonctl",
      "status": "inactive",
      "mode": "local",
      "description": "Example Neon CLI profile using a repository-scoped --config-dir.",
      "authStorageClass": "repository-scoped-config-root",
      "expectedAccountLabelRef": "repo-neon-account",
      "cliAuth": {
        "status": "inactive",
        "profileBoundary": "repository",
        "globalStatePolicy": "refuse-global-mutable-state",
        "configRoot": {
          "strategy": "flag",
          "flag": "--config-dir",
          "executable": "neonctl",
          "providerSubdir": "neonctl"
        },
        "authFlowTypes": ["browser", "api-key"],
        "browserPolicy": "explicit-browser-is-binding",
        "identityCheckCommands": [
          "neonctl me --output json"
        ]
      },
      "verificationCommands": [
        "./{{CLI_NAME}} connections auth-plan --profile example-neon",
        "./{{CLI_NAME}} connections env --profile example-neon"
      ],
      "revocation": "Revoke the Neon grant or API key and remove this profile's external config root."
    },
    {
      "id": "example-github-worker",
      "provider": "github",
      "status": "inactive",
      "mode": "local",
      "description": "Example repository-scoped Worker profile. Replace with a real, least-privilege profile and preserve custom Git/GitHub wrappers before activation.",
      "authStorageClass": "repository-scoped-config-root-and-process-credential",
      "expectedAccountLabelRef": "repo-github-worker-account",
      "readOnlyScopes": ["metadata:read", "contents:read", "issues:read", "pull-requests:read", "actions:read"],
      "approvalGatedWriteScopes": ["contents:write", "issues:write", "pull-requests:write"],
      "cliAuth": {
        "status": "inactive",
        "profileBoundary": "repository",
        "globalStatePolicy": "refuse-global-mutable-state",
        "configRoot": {
          "strategy": "env",
          "env": "GH_CONFIG_DIR",
          "providerSubdir": "github"
        },
        "authFlowTypes": ["browser", "noninteractive"],
        "browserPolicy": "explicit-browser-is-binding",
        "identityCheckCommands": [
          "gh auth status --hostname github.com"
        ]
      },
      "githubAuthority": {
        "tier": "worker",
        "authSourceKind": "github-app-installation",
        "repositoryRef": "{{REPO_SLUG}}",
        "preferredCli": "gh-axi",
        "runtimeAuth": {
          "strategy": "environment",
          "env": "REPO_GITHUB_WORKER_TOKEN"
        },
        "allowedCapabilities": [
          "github.repo.read",
          "github.issue.read",
          "github.issue.create",
          "github.issue.update",
          "github.issue.close",
          "github.issue.comment",
          "github.pr.read",
          "github.pr.create",
          "github.pr.update",
          "github.pr.close",
          "github.pr.comment",
          "github.pr.review",
          "github.workflow.read"
        ]
      },
      "writeApproval": {
        "required": true,
        "policy": "The orchestration node must explicitly allow the exact github.* capability and bind github.profile.example-github-worker before execution."
      },
      "verificationCommands": [
        "./{{CLI_NAME}} connections auth-plan --profile example-github-worker",
        "./{{CLI_NAME}} github plan --profile example-github-worker",
        "./{{CLI_NAME}} github run --profile example-github-worker --dry-run -- pr list"
      ],
      "revocation": "Revoke the GitHub App installation or token source and remove the isolated profile directory."
    }
  ]
}
